# Site values for bam-ioc.service. Copied to /etc/bam-ioc.env by install.sh; installs never overwrite it.
# systemd EnvironmentFile syntax: KEY=value, no `export`, no shell expansion.
# PV prefix: production. Use PEGTEST:DIAG:BAM1: for a commissioning board that must not shadow it.
BAM_PREFIX=PEG:DIAG:BAM1:
# ADC sample rate, MS/s (FREQ_PLAN.md Stage 1: moves the readout band's mirror out of the beam's prompt band).
# Empty or absent: the bitstream's 4423.68. INFO:FsDec reads 491.52 at 3932.16.
BAM_ADC_FS=3932.16
# The board's static address (not chosen yet, PLAN B2); passed as --interfaces
BAM_IP=10.0.0.XXX
# caproto server binds this address only
EPICS_CAS_INTF_ADDR_LIST=10.0.0.XXX
# No beacons to the auto-discovered interfaces
EPICS_CAS_AUTO_BEACON_ADDR_LIST=NO
# Beacons go to the lab subnet broadcast
EPICS_CAS_BEACON_ADDR_LIST=10.0.0.255
# CA server port
EPICS_CA_SERVER_PORT=5064
